# Django
DJANGO_SECRET_KEY=change-me-before-public-use
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL or SQLite)
DB_ENGINE=postgresql
DB_NAME=edutrack
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# E-mail (console backend used by default in DEBUG)
DEFAULT_FROM_EMAIL=Impatrack <nao-responda@impatrack.dev>

# Google OAuth (opcional no desenvolvimento)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend
VITE_API_ORIGIN=
VITE_GOOGLE_ENABLED=false

# Google Antigravity OAuth (Assistente Clippit com Gemini 3.8 Flash)
ANTIGRAVITY_ACCESS_TOKEN=
ANTIGRAVITY_REFRESH_TOKEN=
ANTIGRAVITY_CLIENT_ID=
ANTIGRAVITY_CLIENT_SECRET=
ANTIGRAVITY_PROJECT_ID=
ANTIGRAVITY_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
